{
  "title": "Architecture (State 016 Redis Database Cache)",
  "stateId": "016-redis-database-cache",
  "inheritsFrom": "005-postgres-database-replacement",
  "flowDoc": "../../001-baseline-uncontainerized-parity/system/end-to-end-flows.md",
  "description": "State 016 adds cache-aside reads and post-commit invalidation while PostgreSQL remains authoritative.",
  "mermaidDirection": "LR",
  "entrypoints": [
    {
      "name": "ingress",
      "url": "http://localhost:8080"
    }
  ],
  "nodes": [
    {
      "id": "trader",
      "label": "Trader Browser",
      "kind": "actor",
      "description": "Uses TraderX through ingress."
    },
    {
      "id": "ingress",
      "label": "NGINX Ingress",
      "kind": "gateway",
      "description": "Single browser entrypoint."
    },
    {
      "id": "account",
      "label": "Account Service",
      "kind": "service",
      "description": "Caches account and account-user reads."
    },
    {
      "id": "position",
      "label": "Position Service",
      "kind": "service",
      "description": "Caches trade and position reads."
    },
    {
      "id": "tradeProcessor",
      "label": "Trade Processor",
      "kind": "service",
      "description": "Persists trades and invalidates affected caches after commit."
    },
    {
      "id": "redis",
      "label": "Redis Cache",
      "kind": "cache",
      "description": "Shared, time-bounded read cache."
    },
    {
      "id": "database",
      "label": "PostgreSQL Database",
      "kind": "database",
      "description": "Authoritative account, trade, and position store."
    }
  ],
  "edges": [
    {
      "from": "trader",
      "to": "ingress",
      "label": "Requests"
    },
    {
      "from": "ingress",
      "to": "account",
      "label": "Account API"
    },
    {
      "from": "ingress",
      "to": "position",
      "label": "Portfolio API"
    },
    {
      "from": "account",
      "to": "redis",
      "label": "Cache-aside reads"
    },
    {
      "from": "position",
      "to": "redis",
      "label": "Cache-aside reads"
    },
    {
      "from": "tradeProcessor",
      "to": "redis",
      "label": "Post-commit invalidation"
    },
    {
      "from": "account",
      "to": "database",
      "label": "Authoritative reads/writes"
    },
    {
      "from": "position",
      "to": "database",
      "label": "Cache misses"
    },
    {
      "from": "tradeProcessor",
      "to": "database",
      "label": "Authoritative writes"
    }
  ],
  "notes": [
    "Cache behavior is opt-in and state-local.",
    "Writes always target PostgreSQL.",
    "Default cache lifetime is 30 seconds."
  ]
}
